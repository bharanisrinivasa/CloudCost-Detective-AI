# CloudCost Detective AI - Production Environment Variables Template
# Copy this file to '.env' and populate it with actual production values.
# NEVER commit the actual '.env' file to source control.

# ==========================================
# 1. Django Core Configuration
# ==========================================
DEBUG=False
SECRET_KEY=  # Required: Long, random string for Django crypt/sessions
ALLOWED_HOSTS=  # Required: Comma-separated list (e.g. cost-detective.example.com,12.34.56.78)
CSRF_TRUSTED_ORIGINS=  # Optional: Comma-separated trusted origins (e.g. https://cost-detective.example.com)

# ==========================================
# 2. Database Configuration (PostgreSQL in production)
# ==========================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cloudcost
DB_USER=cloudcost
DB_PASSWORD=  # Required: Strong database password
DB_HOST=db  # Defaults to "db" container in Docker Compose
DB_PORT=5432

# ==========================================
# 3. Redis & Celery Configuration
# ==========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==========================================
# 4. OCI API Integration Settings
# ==========================================
OCI_ENCRYPTION_KEY=  # Required: 32-byte URL-safe base64 encryption key (run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")

# ==========================================
# 5. Explainable GenAI (Gemini) Settings
# ==========================================
GEMINI_API_KEY=  # Required: Google Gemini API key
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# 6. Django Security & HTTPS Cookies
# ==========================================
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False  # Set to True only after confirming HTTPS is active on Nginx
SECURE_HSTS_SECONDS=0  # Set to positive integer (e.g., 31536000) only after confirming HTTPS is active
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ==========================================
# 7. Gunicorn Production Server Tuning
# ==========================================
GUNICORN_WORKERS=  # Defaults to: (2 * cpu_cores) + 1
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=2
