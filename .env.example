# Django settings
SECRET_KEY=your-django-secret-key
DEBUG=True

# Database Configuration (defaults to SQLite if not configured otherwise)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Celery & Cache Settings (planned/future integrations)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
